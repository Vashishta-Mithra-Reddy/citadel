# MongoDB Configuration
# For local MongoDB: mongodb://localhost:27017/citadel
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/citadel
MONGO_URI=mongodb://localhost:27017/citadel

# Better Auth Configuration
# Generate a secure random secret: openssl rand -base64 32
BETTER_AUTH_SECRET=your_random_secret_key_here_min_32_characters

# Application URL
# Development: http://localhost:3000
# Production: https://yourdomain.com
BETTER_AUTH_URL=http://localhost:3000
